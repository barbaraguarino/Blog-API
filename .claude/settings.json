{
  "attribution": {
    "pr": "🤖 Gerado com Claude Code",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bash .claude/scripts/github-leitura.sh *)"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api * -X DELETE *)",
      "Bash(gh api * --method DELETE *)",
      "Bash(gh pr merge *)",
      "Bash(git merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * -f *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(gh auth login *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth token *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh search *)",
      "Bash(gh api *issues*)",
      "Bash(gh api *pulls*)",
      "Bash(gh api *comments*)",
      "Bash(gh repo clone *)",
      "Bash(git clone *)",
      "Bash(gh run download *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo archive *)",
      "PowerShell(gh repo rename *)",
      "PowerShell(gh api * -X DELETE *)",
      "PowerShell(gh api * --method DELETE *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git merge *)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(gh auth login *)",
      "PowerShell(gh auth refresh *)",
      "PowerShell(gh auth logout *)",
      "PowerShell(gh auth token *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh search *)",
      "PowerShell(gh api *issues*)",
      "PowerShell(gh api *pulls*)",
      "PowerShell(gh api *comments*)",
      "PowerShell(gh repo clone *)",
      "PowerShell(git clone *)",
      "PowerShell(gh run download *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-links-de-sessao.sh\"",
            "statusMessage": "Verificando links de sessão"
          }
        ]
      }
    ]
  }
}
